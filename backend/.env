# Environment variables for the backend
SECRET_KEY=devsecret
DATABASE_URL=postgres://edulinker:edulinker@db:5432/edulinker
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000
# JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# Email (usar SMTP en producciÃ³n)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@edulinker.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# S3/MinIO
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_STORAGE_BUCKET_NAME=edulinker
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL_PREFIX=http://localhost:9000/edulinker
AWS_REGION=us-east-1

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Event reminders
EVENT_REMINDER_OFFSETS=24,1
