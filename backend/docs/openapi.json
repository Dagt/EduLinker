          allOf:
          - $ref: '#/components/schemas/User'
          readOnly: true
        action:
          type: string
          maxLength: 100
        entity_type:
          type: string
          maxLength: 100
        entity_id:
          type: integer
          maximum: 2147483647
          minimum: 0
        metadata: {}
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - action
      - actor
      - created_at
      - entity_id
      - entity_type
      - id
      - school
    ChatMessage:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        author:
          type: integer
        author_display:
          type: string
          readOnly: true
        author_role:
          type: string
          readOnly: true
        message_text:
          type: string
        attachment:
          type: string
          format: uri
          writeOnly: true
        attachment_url:
          type: string
          format: uri
          readOnly: true
        message_type:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - attachment_url
      - author
      - author_display
      - author_role
      - created_at
      - id
      - message_type
    Complaint:
