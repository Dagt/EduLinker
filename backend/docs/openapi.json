components:
  schemas:
    ActivityPhoto:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        group:
          type: integer
          nullable: true
        homework:
          type: integer
          nullable: true
        photo_url:
          type: string
          format: uri
          maxLength: 200
        caption:
          type: string
          maxLength: 255
        uploaded_by:
          type: integer
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - photo_url
      - uploaded_by
    Announcement:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        scope:
          $ref: '#/components/schemas/AnnouncementScopeEnum'
        group:
          type: integer
          nullable: true
        teacher:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 255
        message:
          type: string
        attachments: {}
        requires_ack:
          type: boolean
        ack_deadline:
          type: string
          format: date-time
          nullable: true
        locked:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - teacher
      - title
    AnnouncementScopeEnum:
      enum:
      - GLOBAL
      - GRUPO
