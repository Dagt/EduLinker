components:
  schemas:
    ActivityPhoto:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        group:
          type: integer
          nullable: true
        homework:
          type: integer
          nullable: true
        photo_url:
          type: string
          format: uri
          maxLength: 200
        caption:
          type: string
          maxLength: 255
        uploaded_by:
          type: integer
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - photo_url
      - uploaded_by
    Announcement:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        scope:
          $ref: '#/components/schemas/AnnouncementScopeEnum'
        group:
          type: integer
          nullable: true
        teacher:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 255
        message:
          type: string
        attachments: {}
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - teacher
      - title
    AnnouncementScopeEnum:
      enum:
      - GLOBAL
      - GRUPO
      type: string
      description: |-
        * `GLOBAL` - Global
        * `GRUPO` - Grupo
    AssignHomeroomTeacher:
      type: object
      properties:
        homeroom_teacher:
          type: integer
          nullable: true
    AuditLog:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        school:
          type: integer
        actor:
          type: integer
        action:
          type: string
          maxLength: 100
        entity_type:
          type: string
          maxLength: 100
        entity_id:
          type: integer
          maximum: 2147483647
          minimum: 0
        metadata: {}
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - action
      - actor
      - created_at
      - entity_id
      - entity_type
      - id
      - school
    ChatMessage:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        author:
          type: integer
        author_role:
          type: string
          readOnly: true
        message_text:
          type: string
        attachment:
          type: string
          format: uri
