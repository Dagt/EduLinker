        attending_no:
          type: integer
        attending_maybe:
          type: integer
        participation_rate:
          type: number
          format: double
        attendance_by_group:
          type: array
          items: {}
      required:
      - attendance_by_group
      - attending_maybe
      - attending_no
      - attending_yes
      - participation_rate
    AuditLog:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
