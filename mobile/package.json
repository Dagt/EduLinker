{
  "name": "edulinker-mobile",
  "private": true,
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-image-picker": "^16.1.4",
    "expo-secure-store": "~13.0.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "i18n-js": "^4.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "babel-jest": "^30.0.5",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jest-expo": "~51.0.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "react-test-renderer": "^18.2.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "coverageThreshold": {
      "global": {
        "branches": 30,
        "functions": 50,
        "lines": 60,
        "statements": 60
      }
    }
  }
}
